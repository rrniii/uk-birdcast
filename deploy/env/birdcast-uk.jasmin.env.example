# Standalone JASMIN batch configuration. Copy outside the repository and add
# CDS credentials there; the radar-production pipeline remains read-only.
BIRDCAST_UK_RELEASE_SHA=<full-reviewed-main-sha>
BIRDCAST_UK_ROOT=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/releases/<full-reviewed-main-sha>
BIRDCAST_UK_DATA_ROOT=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data
BIRDCAST_UK_ARTIFACT_ROOT=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/artifacts
BIRDCAST_UK_BOUNDARY=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/artifacts/assets/uk-boundary.geojson
BIRDCAST_UK_OBJECT_PREFIX=birdcast-uk
BIRDCAST_UK_OBJECT_STORE_PLAN=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/object-store/plan.json
BIRDCAST_UK_OBJECT_STORE_SYNC_SCRIPT=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/object-store/sync.sh
BIRDCAST_UK_PYTHON=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/releases/<full-reviewed-main-sha>/.venv/bin/python
BIRDCAST_UK_RADARS_FILE=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/radars.json
BIRDCAST_UK_VPTS_CATALOG_URL=https://ncas-radar-o.s3-ext.jc.rl.ac.uk/uk-wsr-visualizer-public/ukmo-nimrod/catalog/vpts/current_ci_le4/catalog.json
BIRDCAST_UK_PUBLIC_BASE_URL=https://ncas-radar-o.s3-ext.jc.rl.ac.uk/uk-wsr-visualizer-public
BIRDCAST_UK_OBJECT_STORE_BUCKET=uk-wsr-visualizer-public
BIRDCAST_UK_OBJECT_STORE_CLIENT=s3cmd
BIRDCAST_UK_EXPECTED_DAYS=365
BIRDCAST_UK_EXPECTED_START_DAY=2025-07-14
BIRDCAST_UK_EXPECTED_END_DAY=2026-07-13
BIRDCAST_UK_HISTORICAL_EXPECTED_LATEST_DATE=2026-08-15
# Immutable, hash-bearing selection manifest for uk-gamm-heldout-v2-sp-vector-925.
BIRDCAST_UK_COMPONENT_MANIFEST=/path/to/component-selection.json
BIRDCAST_UK_COMPONENT_AUTHORITY_DIR=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/model-authority
BIRDCAST_UK_COMPONENT_PREDICTION_DIR=/path/to/private/component-predictions
BIRDCAST_UK_COMPONENT_MERGED_DIR=/path/to/private/component-merged
BIRDCAST_UK_PRIVATE_RUN_ROOT=/path/to/private/research-runs
BIRDCAST_UK_ENABLE_RESEARCH_REFIT=false
# Required only when the research refit gate above is intentionally enabled.
BIRDCAST_UK_GAMM_OPTIONS=/path/to/explicit-gamm-options.json
BIRDCAST_UK_S3CMD_CONFIG=/home/users/rrniii/.s3cfg-birdcast
# Pin a complete common VPTS/ERA5 day for reproducible one-year runs.
BIRDCAST_UK_REANALYSIS_END_DATE=20260713
BIRDCAST_UK_VPTS_ARCHIVE_INVENTORY=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/manifests/vpts-historical-365d.json
BIRDCAST_UK_OBSERVED_HOURLY=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/reanalysis/vpts-hourly.json
BIRDCAST_UK_ERA5_RAW_DIR=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/era5/radar-range-v1/raw
BIRDCAST_UK_ERA5_FEATURE_DIR=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/era5/radar-range-v1/site-features
BIRDCAST_UK_MODEL_FEATURES=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/reanalysis/model-features.json
BIRDCAST_UK_REANALYSIS_TRAINING_TABLE=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/reanalysis/training.json
BIRDCAST_UK_ERA5_GRID_DIR=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/reanalysis/radar-range-v1/era5-grid
BIRDCAST_UK_ERA5_GRID_TABLE=/gws/ssde/j25a/ncas_radar/vol2/avocet/birdcast-uk/data/reanalysis/radar-range-v1/era5-grid-hourly.csv
# Set CDSAPI_RC in the private copied configuration, not here.
