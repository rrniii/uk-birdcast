[Unit]
Description=Promote validated Europe Bird Maps artifacts from Object Store
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=birdcast
Group=birdcast
EnvironmentFile=/etc/birdcast-uk/birdcast-uk.env
EnvironmentFile=/etc/birdcast-uk/birdcast-euro.env
ExecStart=/bin/sh /opt/birdcast-uk/repo/deploy/scripts/birdcast-euro-object-store-pull.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/birdcast-euro
