[Unit]
Description=Build the UK BirdCast 96-hour ensemble forecast
ConditionPathExists=/etc/birdcast-uk/forecast-enabled
After=birdcast-uk-ecmwf-archive.service birdcast-uk-observed-build.service

[Service]
Type=oneshot
User=birdcast
Group=birdcast
EnvironmentFile=/etc/birdcast-uk/birdcast-uk.env
WorkingDirectory=/opt/birdcast-uk/repo
ExecStart=/bin/sh -c 'manifest="$(/opt/birdcast-uk/venv/bin/python -c "import sys; from pathlib import Path; from birdcast_uk.ecmwf import newest_validated_cycle_manifest; path = newest_validated_cycle_manifest(Path(sys.argv[1])); print(path or str())" "$BIRDCAST_UK_ECMWF_CYCLE_DIR")"; [ -n "$manifest" ] || { echo "No validated ECMWF cycle is available" >&2; exit 1; }; exec /opt/birdcast-uk/venv/bin/birdcast-uk forecast build --observed-hourly "$BIRDCAST_UK_OBSERVED_HOURLY" --radars "$BIRDCAST_UK_RADARS_FILE" --output-root "$BIRDCAST_UK_ARTIFACT_ROOT" --ecmwf-manifest "$manifest"'

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/birdcast-uk
